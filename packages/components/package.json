{
  "name": "@deltares/fews-web-oc-components",
  "version": "0.1.3-alpha.7",
  "description": "Library for components used in the FEWS Web OC",
  "license": "AGPL",
  "type": "module",
  "main": "./dist/fews-web-oc-components.umd.js",
  "module": "./dist/fews-web-oc-components.es.js",
  "types": "./dist/types/index.d.ts",
  "typings": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/fews-web-oc-components.es.js",
      "default": "./dist/fews-web-oc-components.umd.js"
    }
  },
  "private": false,
  "scripts": {
    "dev": "vite",
    "serve": "npm run dev",
    "preview": "vite preview",
    "build": "npm run typecheck && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "playwright:install": "playwright install --with-deps",
    "test:components": "playwright test --project=components",
    "test:components:ui": "playwright test --project=components --ui",
    "test:e2e": "cypress open --config-file cypress.json",
    "ci:test:e2e": "cypress run --config-file cypress.json",
    "lint": "eslint --ext .js,.ts,.vue src tests",
    "sonar": "sonar-scanner -Dsonar.host.url=$SONAR_URL -Dsonar.login=$SONAR_TOKEN -Dsonar.projectKey=$SONAR_KEY -Dsonar.projectName='Delft-FEWS Web OC Components'",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@deltares/fews-web-oc-charts": "^4.6.0",
    "vue": "^3.5.40",
    "vuetify": "^4.1.5"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@mdi/font": "^7.4.47",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "10.5.2",
    "@storybook/addon-docs": "10.5.2",
    "@storybook/addon-onboarding": "10.5.2",
    "@storybook/addon-vitest": "10.5.2",
    "@storybook/vue3-vite": "10.5.2",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "10.5.2",
    "eslint-plugin-vue": "^10.9.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.5",
    "sass-embedded": "^1.93.2",
    "storybook": "10.5.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.1.10"
  },
  "files": [
    "dist/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Deltares/fews-web-oc-components"
  },
  "bugs": {
    "url": "https://github.com/Deltares/fews-web-oc-components/issues"
  }
}
