{
  "name": "@deltares/fews-web-oc-components",
  "version": "0.1.3-alpha.7",
  "description": "Library for components used in the FEWS Web OC",
  "license": "AGPL",
  "type": "module",
  "main": "./dist/fews-web-oc-components.umd.js",
  "module": "./dist/fews-web-oc-components.es.js",
  "types": "./dist/types/index.d.ts",
  "typings": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/fews-web-oc-components.es.js",
      "default": "./dist/fews-web-oc-components.umd.js"
    }
  },
  "private": false,
  "scripts": {
    "dev": "vite",
    "serve": "npm run dev",
    "preview": "vite preview",
    "build": "npm run clean && vite build && npm pack",
    "clean": "shx rm -rf dist",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:unit": "jest unit",
    "test:e2e": "cypress open --config-file cypress.json",
    "ci:test:e2e": "cypress run --config-file cypress.json",
    "ci:storybook:serve": "storybook dev -p 6006 --ci --quiet -s public",
    "ci:start-and-test-storybook": "cross-env START_SERVER_AND_TEST_INSECURE=1 \"start-server-and-test ci:storybook:serve http://localhost:6006 ci:test:e2e\"",
    "lint": "eslint --ext .js,.ts,.vue src tests",
    "storybook:build": "storybook build",
    "storybook:serve": "storybook dev -p 6006 -s public",
    "sonar": "sonar-scanner -Dsonar.host.url=$SONAR_URL -Dsonar.login=$SONAR_TOKEN -Dsonar.projectKey=$SONAR_KEY -Dsonar.projectName='Delft-FEWS Web OC Components'"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "vuetify": "^3.7.0"
  },
  "devDependencies": {
    "@vue/compiler-sfc": "^3.5.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@babel/core": "^7.4.5",
    "@mdi/font": "^7.2.96",
    "@storybook/addon-docs": "^7.3.2",
    "@storybook/addon-essentials": "^7.3.2",
    "@storybook/addon-links": "^7.3.2",
    "@storybook/addon-notes": "^5.3.21",
    "@storybook/vue": "^7.3.2",
    "@types/jest": "^27.0.0",
    "@types/lodash": "^4.14.176",
    "@types/node": "^20.5.4",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "@vue/eslint-config-standard": "^8.0.1",
    "@vue/eslint-config-typescript": "^11.0.3",
    "@vue/test-utils": "^1.3.6",
    "cross-env": "^7.0.3",
    "cypress": "^12.17.4",
    "eslint": "^8.47.0",
    "eslint-plugin-cypress": "^2.14.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-standard": "^5.0.0",
    "eslint-plugin-vue": "^9.17.0",
    "jest": "^27.5.1",
    "jest-environment-jsdom": "^27.5.1",
    "jest-junit": "^16.0.0",
    "jest-teamcity-reporter": "^0.9.0",
    "jsdom": "^22.1.0",
    "sass": "^1.66.1",
    "shx": "^0.3.3",
    "sonarqube-scanner": "^3.0.1",
    "start-server-and-test": "^2.0.0",
    "ts-jest": "^27.0.4",
    "typescript": "^4.9.5",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vue-tsc": "^2.1.10",
    "vue-jest": "^3.0.7"
  },
  "jest-junit": {
    "outputDirectory": "reports/",
    "outputName": "junit.xml"
  },
  "files": [
    "dist/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Deltares/fews-web-oc-components"
  },
  "bugs": {
    "url": "https://github.com/Deltares/fews-web-oc-components/issues"
  }
}
