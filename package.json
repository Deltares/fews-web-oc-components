{
  "name": "fews-web-oc-sdk",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:components": "npm run -w @deltares/fews-web-oc-components dev",
    "dev:mf": "npm run -w @deltares/fews-web-oc-micro-frontends dev",
    "docs:api": "npm run -w @deltares/fews-web-oc-composables docs:api",
    "docs:dev": "npm run docs:api && vitepress dev docs",
    "docs:build": "npm run docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build": "npm run --workspaces --if-present build",
    "playwright:install": "npm run --workspaces --if-present playwright:install",
    "release:set": "node scripts/release.mjs set",
    "release:check": "node scripts/release.mjs check",
    "publish:packages": "npm publish -w @deltares/fews-web-oc-components --access public && npm publish -w @deltares/fews-web-oc-composables --access public",
    "test": "npm run --workspaces --if-present test",
    "test:unit": "npm run --workspaces --if-present test:unit",
    "test:component": "npm run --workspaces --if-present test:component",
    "test:component:ui": "npm run --workspaces --if-present test:component:ui",
    "test:e2e": "npm run --workspaces --if-present test:e2e",
    "ci:test:e2e": "npm run --workspaces --if-present ci:test:e2e",
    "lint": "npm run --workspaces --if-present lint"
  },
  "devDependencies": {
    "vitepress": "^2.0.0-alpha.20"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "undici": "^7.3.0"
  },
  "version": "0.3.0-alpha.8",
  "volta": {
    "node": "24.21.0"
  }
}